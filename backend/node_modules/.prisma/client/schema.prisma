datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserGender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum UserRole {
  COMMUTER
  RIDER
  ADMIN
  SUPPORT_AGENT
}

enum KycStatus {
  UNVERIFIED
  SUBMITTED
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum RideStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  ARRIVED
  STARTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  TRANSFERRED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  RAZORPAY
  COMMUTE_WALLET
  UPI_DIRECT
}

enum WalletTxnType {
  TOPUP
  RIDE_PAYMENT_ESCROW
  RIDE_PAYMENT_SETTLED
  RIDER_PAYOUT
  REFUND
  PENALTY
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  WHATSAPP
}

enum NotificationType {
  RIDE_REQUESTED
  RIDE_CONFIRMED
  RIDER_ARRIVED
  RIDE_STARTED
  RIDE_COMPLETED
  PAYMENT_SUCCESS
  SOS_ALERT
  GENERAL
}

model User {
  id              String     @id @default(uuid()) @map("_id")
  phoneNumber     String     @unique @map("phone_number")
  email           String?    @unique
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  gender          UserGender @default(PREFER_NOT_TO_SAY)
  avatarUrl       String?    @map("avatar_url")
  bio             String?
  role            UserRole   @default(COMMUTER)
  kycStatus       KycStatus  @default(UNVERIFIED) @map("kyc_status")
  ratingAvg       Float      @default(5.00) @map("rating_avg")
  ratingCount     Int        @default(0) @map("rating_count")
  isActive        Boolean    @default(true) @map("is_active")
  isPhoneVerified Boolean    @default(false) @map("is_phone_verified")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relationships
  riderProfile      RiderProfile?
  emergencyContacts EmergencyContact[]
  wallet            Wallet?
  bookings          Booking[]          @relation("PassengerBookings")
  reviewsGiven      Review[]           @relation("ReviewsGiven")
  reviewsReceived   Review[]           @relation("ReviewsReceived")
  notifications     Notification[]
  paymentsMade      Payment[]          @relation("PayerPayments")
  payoutsReceived   Payment[]          @relation("RecipientPayments")
  cancelledBookings Booking[]          @relation("CancelledBy")

  @@map("users")
}

model RiderProfile {
  id                   String    @id @default(uuid()) @map("_id")
  userId               String    @unique @map("user_id")
  drivingLicenseNo     String    @unique @map("driving_license_no")
  licenseExpiryDate    DateTime  @map("license_expiry_date")
  licenseDocFrontUrl   String    @map("license_doc_front_url")
  licenseDocBackUrl    String?   @map("license_doc_back_url")
  verificationStatus   KycStatus @default(SUBMITTED) @map("verification_status")
  verifiedAt           DateTime? @map("verified_at")
  rejectionReason      String?   @map("rejection_reason")
  totalTripsOffered    Int       @default(0) @map("total_trips_offered")
  totalTripsCompleted  Int       @default(0) @map("total_trips_completed")
  safetyRatingAvg      Float     @default(5.00) @map("safety_rating_avg")
  isEligibleForPooling Boolean   @default(false) @map("is_eligible_for_pooling")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  rides    Ride[]

  @@map("rider_profiles")
}

model Vehicle {
  id                  String   @id @default(uuid()) @map("_id")
  riderProfileId      String   @map("rider_profile_id")
  licensePlate        String   @unique @map("license_plate")
  make                String
  model               String
  engineCc            Int      @map("engine_cc")
  color               String
  rcNumber            String   @unique @map("rc_number")
  rcDocumentUrl       String   @map("rc_document_url")
  insurancePolicyNo   String   @map("insurance_policy_no")
  insuranceExpiryDate DateTime @map("insurance_expiry_date")
  insuranceDocUrl     String   @map("insurance_doc_url")
  isVerified          Boolean  @default(false) @map("is_verified")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  rides        Ride[]

  @@map("vehicles")
}

model EmergencyContact {
  id           String   @id @default(uuid()) @map("_id")
  userId       String   @map("user_id")
  contactName  String   @map("contact_name")
  relationship String
  phoneNumber  String   @map("phone_number")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model Wallet {
  id                  String   @id @default(uuid()) @map("_id")
  userId              String   @unique @map("user_id")
  currency            String   @default("INR")
  currentBalance      Float    @default(0.00) @map("current_balance")
  lockedEscrowBalance Float    @default(0.00) @map("locked_escrow_balance")
  isFrozen            Boolean  @default(false) @map("is_frozen")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String        @id @default(uuid()) @map("_id")
  walletId       String        @map("wallet_id")
  type           WalletTxnType
  amount         Float
  balanceAfter   Float         @map("balance_after")
  referenceId    String?       @map("reference_id")
  referenceTable String?       @map("reference_table")
  description    String
  createdAt      DateTime      @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@map("wallet_transactions")
}

model Ride {
  id                       String     @id @default(uuid()) @map("_id")
  riderProfileId           String     @map("rider_profile_id")
  vehicleId                String     @map("vehicle_id")
  originLat                Float      @map("origin_lat")
  originLng                Float      @map("origin_lng")
  originAddress            String     @map("origin_address")
  destinationLat           Float      @map("destination_lat")
  destinationLng           Float      @map("destination_lng")
  destinationAddress       String     @map("destination_address")
  routePolyline            String     @map("route_polyline") // Encoded polyline representation
  scheduledDeparture       DateTime   @map("scheduled_departure")
  bufferMinutes            Int        @default(10) @map("buffer_minutes")
  availableSeats           Int        @default(1) @map("available_seats")
  helmetProvided           Boolean    @default(true) @map("helmet_provided")
  isWomenOnly              Boolean    @default(false) @map("is_women_only")
  perKmCostShare           Float      @map("per_km_cost_share")
  estimatedDistanceMeters  Int        @map("estimated_distance_meters")
  estimatedDurationSeconds Int        @map("estimated_duration_seconds")
  status                   RideStatus @default(SCHEDULED)
  recurringCron            String?    @map("recurring_cron")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Restrict)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookings     Booking[]

  @@map("rides")
}

model Booking {
  id                    String        @id @default(uuid()) @map("_id")
  rideId                String        @map("ride_id")
  passengerId           String        @map("passenger_id")
  pickupLat             Float         @map("pickup_lat")
  pickupLng             Float         @map("pickup_lng")
  pickupAddress         String        @map("pickup_address")
  dropoffLat            Float         @map("dropoff_lat")
  dropoffLng            Float         @map("dropoff_lng")
  dropoffAddress        String        @map("dropoff_address")
  pickupOtp             String        @map("pickup_otp")
  status                BookingStatus @default(REQUESTED)
  fareFuelShare         Float         @map("fare_fuel_share")
  platformFee           Float         @map("platform_fee")
  insuranceFee          Float         @map("insurance_fee")
  totalFare             Float         @map("total_fare")
  detourDistanceMeters  Int           @default(0) @map("detour_distance_meters")
  detourDurationSeconds Int           @default(0) @map("detour_duration_seconds")
  requestedAt           DateTime      @default(now()) @map("requested_at")
  confirmedAt           DateTime?     @map("confirmed_at")
  startedAt             DateTime?     @map("started_at")
  completedAt           DateTime?     @map("completed_at")
  cancelledAt           DateTime?     @map("cancelled_at")
  cancelledById         String?       @map("cancelled_by_id")
  cancellationReason    String?       @map("cancellation_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Restrict)
  passenger   User     @relation("PassengerBookings", fields: [passengerId], references: [id], onDelete: Restrict)
  cancelledBy User?    @relation("CancelledBy", fields: [cancelledById], references: [id])
  payment     Payment?
  reviews     Review[]

  @@map("bookings")
}

model Payment {
  id                String        @id @default(uuid()) @map("_id")
  bookingId         String        @unique @map("booking_id")
  payerId           String        @map("payer_id")
  recipientId       String        @map("recipient_id")
  gatewayOrderId    String        @unique @map("gateway_order_id")
  gatewayPaymentId  String?       @unique @map("gateway_payment_id")
  gatewayTransferId String?       @unique @map("gateway_transfer_id")
  paymentMethod     PaymentMethod @default(RAZORPAY) @map("payment_method")
  totalAmount       Float         @map("total_amount")
  platformCut       Float         @map("platform_cut")
  riderPayout       Float         @map("rider_payout")
  insurancePremium  Float         @default(0.00) @map("insurance_premium")
  status            PaymentStatus @default(INITIATED)
  errorCode         String?       @map("error_code")
  errorMessage      String?       @map("error_message")
  capturedAt        DateTime?     @map("captured_at")
  transferredAt     DateTime?     @map("transferred_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payer     User    @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Restrict)
  recipient User    @relation("RecipientPayments", fields: [recipientId], references: [id], onDelete: Restrict)

  @@map("payments")
}

model Review {
  id         String   @id @default(uuid()) @map("_id")
  bookingId  String   @map("booking_id")
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  rating     Int
  safetyTags String[] @default([]) @map("safety_tags")
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([bookingId, reviewerId])
  @@map("reviews")
}

model Notification {
  id               String              @id @default(uuid()) @map("_id")
  userId           String              @map("user_id")
  title            String
  body             String
  channel          NotificationChannel @default(IN_APP)
  notificationType NotificationType    @default(GENERAL) @map("notification_type")
  metadata         Json                @default("{}")
  isRead           Boolean             @default(false) @map("is_read")
  readAt           DateTime?           @map("read_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
