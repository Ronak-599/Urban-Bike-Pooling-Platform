# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/twoshare_db?retryWrites=true&w=majority&appName=TwoShare

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-change-in-production-min-32
REFRESH_TOKEN_EXPIRES_IN=30d

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Google Maps API (Optional for direct Directions API calls)
GOOGLE_MAPS_API_KEY=placeholder_google_maps_api_key
